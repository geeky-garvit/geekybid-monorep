{
  "name": "geeky-bid-monorepo",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.0.0"
  },
  "overrides": {
    "@babel/core": "7.26.9",
    "@babel/preset-typescript": "7.26.0",
    "@babel/preset-env": "7.26.9"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0"
  }
}
